+    source.write_text("""#include "menu_quit.h"
+#include <cassert>
+int main() {
+    mkwvk::menu_quit::Release gate;
+    for (int press = 0; press < 2; ++press) {
+        assert(!gate.accept(false, true));
+        assert(gate.accept(true, true));
+        assert(!gate.accept(true, true));
+        assert(!gate.accept(false, false));
+    }
+}""")
+    compile_run(source, tmp_path)
