+"""Exercise the sticky header and production input branch without a game window."""
+
+import os
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+MENU = (ROOT / "gpu/vk/vk_menu.cpp").read_text(encoding="utf8")
+
+
+def compile_run(source, tmp):
+    exe = tmp / "test.exe"
+    subprocess.run(
+        [os.environ.get("CXX", "g++"), "-std=c++20", "-I" + str(ROOT / "gpu/vk"), str(source), "-o", str(exe)],
+        check=True,
+        timeout=60,
+    )
+    subprocess.run([str(exe)], check=True, timeout=10)
+
+
+def test_header(tmp_path):
+    draw = MENU.split("void draw_options(", 1)[1].split("void draw_tune_bar(", 1)[0]
+    assert draw.index("menu_hit::kQuit") < draw.index("if (cur_tab == TAB_MODS)")
+    assert "quit_focus.active ? ui::kGold : ui::kTabInset" in draw
+    assert "quit_focus.active ? ui::kGoldInk : ui::kInkBright" in draw
+    assert "hit.part == menu_hit::kQuit && quit_focus.active) press[7] = true" in MENU
+    compile_run(ROOT / "tests/test_menu_quit.cpp", tmp_path)
+
+
+def test_quit_navigation(tmp_path):
+    branch = MENU.split("if (tab_left || tab_right || tune_toggle)", 1)[1].split(
+        "} else if (cur_tab == TAB_MODS) {   // (the Mods tab: its own lines", 1
+    )[0]
+    enums = MENU.split("enum MenuTab {", 1)[1].split("};", 1)[0]
+    focus = MENU.split("auto focus_quit = ", 1)[1].split("    if (!mine", 1)[0]
+    fixture = (
+        r"""
+#include "menu_quit.h"
+#include <cassert>
+#include <atomic>
+using namespace mkwvk;
+enum MenuTab {ENUMS};
+int cur_tab, tab_selected[TAB_PAGE+1]{}, mods_sel=0, mods_grab=-1, page=0, ask_sel=0;
+int closes=0,saves=0,caches=0; bool mods=true,dirty=false,tune_mode=false,quick_debug=false;
+std::atomic<bool> open_now{true};
+bool tab_shown(int t){return t!=TAB_MODS || mods;} bool restart_ask(){return dirty;}
+struct Setting {void (*on_activate)();} action{[]{++closes;}};
+struct Row {bool heading;Setting* setting;}; Row rows[]={{true,nullptr},{false,nullptr},{false,&action}};
+const Row* pending=nullptr; const Row* quit_action(){return rows+2;}
+int tab_row_count(int){return 3;} int tab_row_to_global(int,int k){return k;}
+struct Lines{int size(){return 3;}}; Lines mod_lines(){return {};}
+int mods_step(Lines,int,int dir){return dir>0?1:2;} int debug_step(int sel,int){return sel<0?1:2;}
+void save(){++saves;} void pipeline_cache_save(bool force){assert(force);++caches;}
+menu_quit::Focus quit_focus; menu_quit::Release quit_release;
+void tick(int key=-1,int source=0,bool hold=false,bool tab_right=false){
+    bool press[18]{},held[18]{}, changed=false,mine=true,tab_left=false,tune_toggle=false;
+    if(key>=0)press[key]=true;
+    held[7]=hold&&source==0; int raw=hold&&source==1?4:0,pad_confirm=2,HOS_MOUSE_LEFT=1;
+    struct {int held;} ptr{hold&&source==2};
+    auto focus_quit = FOCUS
+    if (tab_left || tab_right || tune_toggle) BRANCH }
+}
+int main(){
+    for(int t=0;t<=TAB_MOTION;++t){
+        cur_tab=t; int& sel=t==TAB_MODS?mods_sel:tab_selected[t]; sel=1;
+        tick(1); assert(quit_focus.active); tick(1); assert(!quit_focus.active && sel==2);
+        sel=1; tick(1); tick(2); assert(!quit_focus.active && sel==1); tick(1);
+        for(int src=0;src<3;++src){
+            int before=closes; tick(7,src,true); assert(pending);
+            for(int i=0;i<60;++i) tick(7,(src+1)%3,true);
+            assert(closes==before); tick(); dirty=true; tick(5); dirty=false;
+            assert(!pending && quit_focus.active && cur_tab==t && page==0 && open_now);
+            tick(7,src,true); tick(); tick(7,(src+1)%3,true); tick();
+            assert(!pending && closes==before+1 && closes==saves && closes==caches);
+        }
+        tick(7); tick(-1,0,false,true); assert(!pending && !quit_focus.active);
+    }
+    mods=false;cur_tab=TAB_NFC;tick(-1,0,false,true);assert(cur_tab==TAB_DEBUG);
+    dirty=true;tick(5);assert(page==5 && !pending && open_now);
+}
+""".replace("ENUMS", enums)
+        .replace("FOCUS", focus)
+        .replace("BRANCH", branch)
+    )
+    source = tmp_path / "menu_quit_integration.cpp"
+    source.write_text(fixture, encoding="utf8")
+    compile_run(source, tmp_path)
