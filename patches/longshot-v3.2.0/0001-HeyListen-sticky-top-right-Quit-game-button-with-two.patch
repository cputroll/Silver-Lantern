+        auto h = menu_quit::layout(width, 1.f, 16.f, 650.f);
+        assert(h.tab_left >= 0 && h.tab_left + 650.f*h.tab_scale <= h.left);
+        assert(h.left < h.right && h.right <= width && width-h.right == 16.f);
+        menu_hit::Map hits{};
+        hits.clear(0, 0, width, 720);
+        hits.add(h.left, 4, h.right, 50, menu_hit::kQuit, -1);
+        for (int scroll : {0, 12, 30}) {
+            hits.add(0, 80, width, 110, menu_hit::kRow, scroll);
+            assert(hits.at((h.left+h.right)/2, 25).part == menu_hit::kQuit);
+        }
+    }
+    menu_quit::Release gate;
+    assert(gate.accept(true, true)); // first keyboard, pad, or pointer edge
+    for (int i=0; i<100; ++i) assert(!gate.accept(true, true));
+    assert(!gate.accept(false, false));
+    assert(gate.accept(true, true)); // independent confirmation
+    menu_quit::Focus f;
+    assert(!f.active);
+    assert(!f.navigate(true,false,false)); // up from an ordinary row
+    assert(f.navigate(true,false,true) && f.active);
+    assert(f.navigate(false,true,true) && !f.active); // restore first setting
+}
