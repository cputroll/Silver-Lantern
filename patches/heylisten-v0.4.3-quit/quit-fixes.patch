+"""Exercise the fixed header geometry and the menu's actual navigation/exit branches without closing a game."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+menu = (ROOT / 'gpu/vk/vk_menu.cpp').read_text(encoding='utf8')
+draw = menu.split('void draw_options(', 1)[1].split('ui::prompt_bar(c, prompt_list', 1)[0]
+assert 'menu_hit::kQuit' in draw.split('scroll_rows(cur_tab', 1)[0], 'no fixed Quit game hit target'
+assert 'quit_focus.active ? ui::kGold : ui::kTabInset' in draw, 'Quit focus needs the gold selection fill'
+assert 'quit_focus.active ? ui::kGoldInk : ui::kInkBright' in draw, 'Quit focus needs dark text on gold'
+assert 'if (hit.part == menu_hit::kQuit) press[7] = true;' in menu
+toggle = menu[menu.index('    if (press[0] || press[6] || !mine)'):menu.index('        // (the layout row shows')] + '    }'
+branch = menu[menu.index('if (open_now.load()) {', menu.index('if (changed) teleport_reveal();')):menu.index(' else if (r.cheat >= 0) cheat_press')]
+fixture = r'''
+#include "menu_quit.h"
+#include "vk_menu_hit.h"
+#include <atomic>
+#include <cassert>
+using namespace mkwvk;
+struct Row { bool heading; int *value,lo,hi,step,cheat; }; Row rows[12] = {{true}};
+const int kQuitRow=11,kRestartRow=10,TAB_COUNT=4,TAB_MOTION=4,TAB_CONTROLS=2;
+int tab_row_count(int t){return t==1 ? 3 : 2;} int tab_row_to_global(int t,int s){return t==1 && s==2 ? kQuitRow : 2*t+s;}
+int selected_tab=0,tab_selected[5]{},cur_tab=0,ask_sel=0,page=0,closes=0,saves=0,caches=0;
+std::atomic<bool> open_now{true}; Row* pending=nullptr;
+menu_quit::Focus quit_focus; menu_quit::Release quit_release;
+using HWND=int; constexpr int WM_APP=100, WM_CLOSE=1,HOS_MOUSE_LEFT=1,HOS_MOUSE_RIGHT=2;
+void logf(const char*){} HWND app_window(){return 1;} void save(){++saves;}
+void pipeline_cache_save(bool force){assert(force);++caches;}
+void PostMessageA(HWND,int msg,int,int){assert(msg==WM_CLOSE);++closes;}
+bool restart_ask(){return false;}
+void change_row(Row&,int,int,bool=true){assert(false);} bool cheat_chooses(int){return false;}
+void tick(int key=-1,int src=0,bool hold=false,bool tab_right=false,bool moved=false,bool right=false,bool left=false,int mx=0){
+    bool changed=false,mine=true,tab_left=false,press[18]{},held[18]{};
+    if(key>=0)press[key]=true;
+    held[7]=hold&&src==0; int pad_confirm=2,raw=(hold&&src==1)?4:0;
+    struct {int held,pressed,wheel;} ptr{hold&&src==2,right?HOS_MOUSE_RIGHT:left?HOS_MOUSE_LEFT:0,0};
+    bool mouse=moved||left||right; menu_hit::Map hits{}; int my=0,hover_tab=-1,drag_row=-1,wheel_rows[5]{};
+    hits.clear(0,0,100,100); hits.add(10,0,20,10,menu_hit::kQuit,-1);
+    int listening=0; auto later=[](){assert(false);};
+    TOGGLE
+    BRANCH
+    }
+}
+int main(){
+    for(int t=0;t<4;t++){
+        assert(cur_tab==t && !quit_focus.active && !pending);
+        tab_selected[t]=(t==0 ? 1 : 0);
+        tick(1); assert(quit_focus.active);
+        tick(1); assert(!quit_focus.active && tab_selected[t]==tab_row_count(t)-1);
+        tab_selected[t]=(t==0 ? 1 : 0);
+        tick(1); assert(quit_focus.active);
+        tick(2); assert(!quit_focus.active && tab_selected[t]==(t==0 ? 1 : 0));
+        tick(1);assert(quit_focus.active);
+        for(int src=0;src<3;src++){
+            int before=closes;
+            tick(7,src,true); assert(pending && closes==before);
+            for(int n=0;n<60;n++)tick(7,src,true);
+            tick(); assert(closes==before && pending);
+            tick(5);assert(open_now && !pending && closes==before);
+            tick(7,src,true);tick();tick(7,(src+1)%3,true);tick();
+            assert(closes==before+1 && !pending && saves==closes && caches==closes);
+        }
+        tick(7);tick(-1,0,false,true);assert(!pending && !quit_focus.active);
+    }
+    for(bool right : {true,false}) {
+        tick(1);tick(7);assert(quit_focus.active && pending);
+        tick(right?-1:5,0,false,false,true,right); // hover off with right-click or Esc/controller Back
+        assert(open_now && !quit_focus.active && !pending);
+    }
