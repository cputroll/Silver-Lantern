new file mode 100644
index 0000000000000000000000000000000000000000..46d244f407795f1a99d0b42ea5c4c1ab7531195d
--- /dev/null
+++ b/engine/gpu/vk/menu_quit.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+
+namespace mkwvk::menu_quit {
+struct Header { float left, right, tab_left, tab_scale; };
+// Reserve the button first. Shrink the whole tab strip (including its bumpers)
+// together only if it no longer fits to the left of the button.
+inline Header layout(float width, float s, float safe, float strip) {
+    const float right = width - safe, left = right - 132*s;
+    const float room = std::max(0.f, left - 8*s);
+    const float scale = std::min(1.f, room / strip);
+    const float start = std::min((width-strip*scale)/2, room-strip*scale);
+    return {left, right, std::max(0.f,start), scale};
+}
+struct Focus {
+    bool active = false;
+    bool navigate(bool up, bool down, bool first) {
+        if (active && (up || down)) { active = false; return true; }
+        if (first && up) { active = true; return true; }
+        return false;
+    }
+};
+struct Release {
+    bool locked = false;
+    bool accept(bool edge, bool held) {
+        const bool accepted = edge && !locked;
+        locked = held;
+        return accepted;
+    }
+};
+}
